# Copy to .dev.vars (gitignored) and fill in. Never commit real values.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
# MailerSend, for the contact form. Empty means the message is stored but no
# email goes out and the row records 'skipped'.
MAILERSEND_API_KEY=
# Cloudflare Turnstile's documented always-pass test keys, safe to commit.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Any long random string. IP addresses are stored only as SHA-256 of salt + IP,
# and without a salt nothing is stored at all.
IP_HASH_SALT=

