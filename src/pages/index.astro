---
import BaseLayout from '../layouts/BaseLayout.astro';
import { person } from '../data/person';
---

<BaseLayout
  title={`${person.name} · ${person.alternateName}`}
  description={person.bioShort}
  canonical="/"
  ogType="website"
  fullTitle
>
  <section class="section" aria-labelledby="home-title">
    <div class="container flow">
      <h1 id="home-title">{person.name}</h1>
    </div>
  </section>
</BaseLayout>
