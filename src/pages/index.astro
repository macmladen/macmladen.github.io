---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import headshot from '../assets/mladen-head-2020.jpg';
import roomPhoto from '../assets/workshop.png';
import { person } from '../data/person';
import { workshop } from '../data/workshop';
import { dayAndMonth, timeOfDay } from '../lib/dates';
import { graph, personNode, webSiteNode } from '../lib/schema';

/** One set of options for the headshot, used both by <Image> and by the
 *  Person node, so the JSON-LD points at the file the page actually renders.
 *  560px covers every slot the portrait occupies. From 768px it floats at
 *  --width-portrait-lg 280px, so 560 is exactly 2x there. Below 768px it is a
 *  block that fills the narrow container, whose widest case is a 767px
 *  viewport: 720px capped less the 48px gutter, 672px. 560 is 0.83x of that
 *  worst case, on a screen that is almost always 2x or 3x anyway, and holding
 *  the number where it is keeps one emitted file for the page image, the
 *  Person node and /about/. */
const headshotOptions = { src: headshot, width: 560, height: 560, format: 'webp' } as const;
const headshotFile = await getImage(headshotOptions);

const schema = graph(webSiteNode(Astro.site), personNode(Astro.site, headshotFile.src));

// draft: Mladen to approve — purpose-written meta description for the home page.
const description =
  'Senior developer and architect in Novi Sad: WordPress, Drupal and modern ' +
  'JavaScript, and a hands-on WordCamp Belgrade 2026 workshop on Docker and AI agents.';
---

<BaseLayout
  title={`${person.name} · ${person.alternateName}`}
  description={description}
  canonical="/"
  ogType="website"
  fullTitle
>
  <StructuredData slot="head" data={schema} />

  <section class="section" aria-labelledby="intro-title">
    {
      /* One column, no grid: the portrait is a float, so the paragraphs wrap
         around it from 768px and sit under it below that. .flow-root closes
         the container over the float, since nothing follows it to clear. */
    }
    <div class="container container--narrow flow flow-root">
      <h1 id="intro-title">{person.name}</h1>
      <!-- draft: Mladen to approve -->
      <p class="subtitle subtitle--lead">{person.tagline}</p>
      <Image
        {...headshotOptions}
        alt="Mladen Djuric"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        class="portrait portrait--float portrait--float-lg"
      />
      {person.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="section section--alt section--tight" aria-labelledby="workshop-title">
    <div class="container split split--media-first">
      <div class="flow">
        {
          /* Two lines in one eyebrow: the conference first, so the block reads
             as part of WordCamp before it reads as a date. */
        }
        <p class="eyebrow">
          <strong>{workshop.wordcampName}</strong>{' · workshop'}<br />
          <time datetime={workshop.date}>{dayAndMonth(workshop.start)}</time>{' · '}<time
            datetime={workshop.start}>{timeOfDay(workshop.start)}</time>{` · ${workshop.venue}`}
        </p>
        <h2 id="workshop-title">{workshop.title}</h2>
        <!-- draft: Mladen to approve -->
        <p>
          Bring a laptop and leave with a running local WordPress, a project under
          version control, and an AI agent set up to work on your own code. One full
          loop, live: plan the task, let the agent build and check it, review, deploy.
        </p>
        <div class="row">
          <a class="button" href={`${workshop.path}#register`}>Register for the workshop</a>
          <a class="button button--secondary" href={workshop.sessionUrl}>
            {workshop.wordcampName}
          </a>
        </div>
      </div>
      <figure class="credit-frame">
        <Image
          src={roomPhoto}
          width={800}
          height={533}
          format="webp"
          alt="Training classroom with laptops and code on the projector screen"
          loading="lazy"
          class="media"
        />
        <figcaption class="credit">Image: AI-generated (OpenAI)</figcaption>
      </figure>
    </div>
  </section>
</BaseLayout>

