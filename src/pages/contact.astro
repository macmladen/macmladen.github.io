---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import ContactForm from '../components/ContactForm.astro';
import { person } from '../data/person';
import { contactPageNode, graph, personNode } from '../lib/schema';

const schema = graph(contactPageNode(Astro.site, personNode(Astro.site)));

/** The two profiles that are places to reach him. Speaker Deck is a slide
 *  archive, not an inbox, and is linked from /speaking/ instead. */
const reachableAt = ['LinkedIn', 'GitHub'];
// SSH public keys are published at /keys.txt (public/), as the 2017 site did with /id_rsa.pub.
const contactProfiles = person.profiles.filter((profile) => reachableAt.includes(profile.name));

/** Link text is the address itself, without the scheme, so the visible line
 *  and the href can never say different things. */
const readable = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/+$/, '');

// Approved by Mladen 2026-09-10.
const description =
  'How to reach Mladen Djuric: the contact form on this page, email, LinkedIn or GitHub.';
---

<BaseLayout title="Contact" description={description} canonical="/contact/">
  <StructuredData slot="head" data={schema} />

  <section class="section" aria-labelledby="contact-title">
    <div class="container container--narrow flow">
      <h1 id="contact-title">Contact</h1>
      <!-- draft: Mladen to approve -->
      <p>
        Email is the best way to reach me: work, a workshop, a talk, or the meaning
        of life. Even better, meet me in person. Somewhere.
      </p>
      <dl class="contact">
        <dt>Email</dt>
        <dd><a href={`mailto:${person.email}`}>{person.email}</a></dd>
        {
          contactProfiles.map((profile) => (
            <Fragment>
              <dt>{profile.name}</dt>
              <dd>
                <a href={profile.url} rel="me">
                  {readable(profile.url)}
                </a>
              </dd>
            </Fragment>
          ))
        }
        <dt>SSH keys</dt>
        <dd><a href="/keys.txt">macmladen.com/keys.txt</a> (ed25519 and RSA)</dd>
      </dl>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="form-title">
    <div class="container container--narrow flow">
      <h2 id="form-title">Or write from here</h2>
      <!-- draft: Mladen to approve -->
      <p>
        Four kinds of reason, and a box for whatever the reason really is. It lands in
        the same inbox as the address above, carrying yours, so a reply goes straight
        back.
      </p>
      <ContactForm />
    </div>
  </section>

  {
    /* The page's one inline script, hashed in the CSP (npm run check:csp). It
       does two things: it preselects the topic from a ?topic= query key, and it
       submits the contact form without leaving the page. Both are enhancement —
       with JavaScript off the select opens on "Choose one" and the form posts to
       /api/contact/ as a form always has.

       Preselect: /about/ and /speaking/ link here with ?topic=…, and the visitor
       should land on the form already pointed the right way. The guard is the
       select's own value. The placeholder option carries value="", so an
       untouched form reads as empty; anything else means a topic is already
       chosen — which is what the endpoint renders after a failed submission, and
       what the form below carries after a failed submission made with fetch —
       and the query string must not overwrite the visitor's pick.

       The second half is the same block as on the workshop page, on purpose: one
       script per page keeps the CSP to one hash per page, and the endpoints
       answer both forms the same way. */
  }
  <script is:inline>
    (() => {
      /* Topic from the query string, unless a topic is already chosen. Run again
         after the form is re-rendered, when the select comes back untouched. */
      const enhance = () => {
        const select = document.getElementById('topic');
        if (!select || select.value !== '') return;
        const wanted = new URLSearchParams(location.search).get('topic');
        if (wanted && [...select.options].some((option) => option.value === wanted)) {
          select.value = wanted;
        }
      };

      enhance();

      /* Submitting without leaving the page. The endpoint keeps answering with
         a whole rendered page — the very one a submission without JavaScript
         lands on — and this lifts out of it the part that changed: the success
         block, or the form carrying its errors and the values that were typed.
         The rendering path stays on the server either way. */
      const form = document.querySelector('[data-form-root]');
      if (!form) return;

      const pristine = form.innerHTML;
      let notice = null;

      /* The one block above the form: replaced on every attempt and focused, so
         the answer is both read out and scrolled to. */
      const answer = (block, role) => {
        if (notice) notice.remove();
        notice = block;
        block.classList.add('notice--live');
        block.setAttribute('role', role);
        block.tabIndex = -1;
        form.before(block);
        block.focus();
      };

      const failed = (text) => {
        const block = document.createElement('p');
        block.className = 'notice notice--error';
        block.textContent = text || form.dataset.fail;
        return block;
      };

      /* Turnstile keeps one widget per container. A container it has already
         filled — Turnstile renders the widget into a child of its own — is
         reset; an empty one, which is what new markup brings, has to be
         rendered into. */
      const challenge = () => {
        const box = form.querySelector('.cf-turnstile');
        if (!box || !window.turnstile) return;
        if (box.firstElementChild) window.turnstile.reset(box);
        else {
          window.turnstile.render(box, { sitekey: box.dataset.sitekey, theme: box.dataset.theme });
        }
      };

      const submitting = (state) => {
        const button = form.querySelector('[type="submit"]');
        if (button) button.disabled = state;
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        submitting(true);

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'X-Requested-With': 'fetch' },
            credentials: 'same-origin',
          });
          const page = new DOMParser().parseFromString(await response.text(), 'text/html');
          const success = page.querySelector('[data-form-success]');
          const again = page.querySelector('[data-form-root]');

          if (response.ok && success) {
            form.innerHTML = pristine;
            enhance();
            answer(document.importNode(success, true), 'status');
          } else if (again) {
            /* The general message moves above the form; the fields keep the
               errors beside them and the values that were typed. */
            const general = again.querySelector('.notice--error');
            const text = (general ?? again.querySelector('.field__error'))?.textContent.trim();
            if (general) general.remove();
            form.innerHTML = again.innerHTML;
            enhance();
            answer(failed(text), 'alert');
          } else {
            answer(failed(), 'alert');
          }
        } catch {
          answer(failed(), 'alert');
        }

        challenge();
        submitting(false);
      });
    })();
  </script>
</BaseLayout>
