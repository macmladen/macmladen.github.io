---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import ContactForm from '../components/ContactForm.astro';
import { person } from '../data/person';
import { contactPageNode, graph, personNode } from '../lib/schema';

const schema = graph(contactPageNode(Astro.site, personNode(Astro.site)));

/** The two profiles that are places to reach him. Speaker Deck is a slide
 *  archive, not an inbox, and is linked from /speaking/ instead. */
const reachableAt = ['LinkedIn', 'GitHub'];
const contactProfiles = person.profiles.filter((profile) => reachableAt.includes(profile.name));

/** Link text is the address itself, without the scheme, so the visible line
 *  and the href can never say different things. */
const readable = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/+$/, '');

// draft: Mladen to approve — meta description for /contact/.
const description =
  'How to reach Mladen Djuric: email, LinkedIn and GitHub. A contact form follows ' +
  'once the workshop registration is behind us.';
---

<BaseLayout title="Contact" description={description} canonical="/contact/">
  <StructuredData slot="head" data={schema} />

  <section class="section" aria-labelledby="contact-title">
    <div class="container container--narrow flow">
      <h1 id="contact-title">Contact</h1>
      <!-- draft: Mladen to approve -->
      <p>
        Email is the surest way to reach me: work, a workshop, a talk, or the meaning
        of life. Even better, meet me in person. Somewhere.
      </p>
      <dl class="contact">
        <dt>Email</dt>
        <dd><a href={`mailto:${person.email}`}>{person.email}</a></dd>
        {
          contactProfiles.map((profile) => (
            <Fragment>
              <dt>{profile.name}</dt>
              <dd>
                <a href={profile.url} rel="me">
                  {readable(profile.url)}
                </a>
              </dd>
            </Fragment>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="form-title">
    <div class="container container--narrow flow">
      <h2 id="form-title">Or write from here</h2>
      <!-- draft: Mladen to approve -->
      <p>
        Four kinds of reason, and a box for whatever the reason really is. It lands in
        the same inbox as the address above, carrying yours, so a reply goes straight
        back.
      </p>
      <ContactForm />
    </div>
  </section>

  {
    /* The site's only script, and only on this page. /about/ and /speaking/ link
       here with ?topic=…; this reads that key and preselects the matching
       option, so the visitor lands on the form already pointed the right way.
       Pure enhancement: without JavaScript the select simply opens on "Choose
       one", as it does for anyone arriving without the parameter.

       The guard is the select's own value. The placeholder option carries
       value="", so an untouched form reads as empty; anything else means a topic
       is already chosen — which is what /api/contact/ renders after a failed
       submission — and the query string must not overwrite the visitor's pick.
       That page renders its own copy of the form and does not include this
       script, so the guard is belt as well as braces, and stays correct if the
       script ever moves into the component. */
  }
  <script is:inline>
    (() => {
      const select = document.getElementById('topic');
      if (!select || select.value !== '') return;
      const wanted = new URLSearchParams(location.search).get('topic');
      if (wanted && [...select.options].some((option) => option.value === wanted)) {
        select.value = wanted;
      }
    })();
  </script>
</BaseLayout>
