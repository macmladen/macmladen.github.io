---
/** The one server-rendered route on this site: the workshop registration form's
 *  POST target. It is an Astro page rather than a .ts endpoint on purpose — the
 *  answer to a submission is a rendered page (the form again with its errors, or
 *  the success state), and only a page gets the site's inlined stylesheet and the
 *  shared header and footer. Because trailingSlash is 'always', the route is
 *  /api/register/ and that is what the form's action says. */
export const prerender = false;

import { env as workerEnv } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RegistrationForm from '../../components/RegistrationForm.astro';
import RegistrationSuccess from '../../components/RegistrationSuccess.astro';
import RegistrationClosed from '../../components/RegistrationClosed.astro';
import { emptyValues, type RegistrationErrors, type RegistrationValues } from '../../data/registration';
import { workshop, isRegistrationOpen } from '../../data/workshop';
import { hasErrors, messages, readForm, validate } from '../../lib/validate';
import { verifyTurnstile } from '../../lib/turnstile';
import { upsertSubscriber } from '../../lib/mailerlite';
import { findByEmail, hashIp, insertRegistration, setMailerliteStatus } from '../../lib/registrations';

if (Astro.request.method !== 'POST') {
  return new Response('This address only accepts the registration form (POST).', {
    status: 405,
    headers: { Allow: 'POST', 'Content-Type': 'text/plain; charset=utf-8' },
  });
}

const env = workerEnv as WorkerEnv;
const ip = Astro.request.headers.get('CF-Connecting-IP');

let values: RegistrationValues = emptyValues;
let errors: RegistrationErrors = {};
let registered = false;
let status = 422;

const open = isRegistrationOpen();

if (open) {
  const form = await Astro.request.formData();
  values = readForm(form);
  errors = validate(values);

  if (!hasErrors(errors)) {
    const token = form.get('cf-turnstile-response');
    const passed = await verifyTurnstile(
      typeof token === 'string' ? token : '',
      env.TURNSTILE_SECRET,
      ip,
    );
    if (!passed) errors.form = messages.turnstile;
  }

  if (!hasErrors(errors)) {
    const db = env.DB;
    if (!db) {
      // No binding: say so instead of pretending the registration worked.
      errors.form = messages.unavailable;
      status = 503;
    } else {
      try {
        const existing = await findByEmail(db, values.email);
        if (existing) {
          errors.email = messages.duplicate;
        } else {
          // D1 first: the registration is what matters. MailerLite comes after
          // and only decides what goes in mailerlite_status.
          const id = await insertRegistration(db, values, await hashIp(ip, env.IP_HASH_SALT));
          const mailerlite = await upsertSubscriber(values, env);
          await setMailerliteStatus(db, id, mailerlite);
          registered = true;
          status = 200;
        }
      } catch (error) {
        console.error('[register] database error', error);
        errors.form = messages.unavailable;
        status = 503;
      }
    }
  }
} else {
  status = 403;
}

Astro.response.status = status;
Astro.response.headers.set('Cache-Control', 'no-store');

const title = registered ? 'You are registered' : 'Registration';
---

<BaseLayout
  title={title}
  description={workshop.summary}
  canonical={workshop.path}
  ogType="article"
>
  <meta name="robots" content="noindex" slot="head" />

  <section class="section" aria-labelledby="result-title">
    <div class="container container--narrow flow">
      <h1 id="result-title">{title}</h1>
      <p class="eyebrow">
        <a href={workshop.path}>{workshop.title}</a>
      </p>

      {!open && <RegistrationClosed />}

      {open && registered && <RegistrationSuccess email={values.email} />}

      {
        open && !registered && (
          <Fragment>
            <p>Nearly there. What is marked below still needs a moment.</p>
            <RegistrationForm values={values} errors={errors} />
          </Fragment>
        )
      }
    </div>
  </section>
</BaseLayout>
