---
import { getImage } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StructuredData from '../../../components/StructuredData.astro';
import Facts from '../../../components/Facts.astro';
import RegistrationForm from '../../../components/RegistrationForm.astro';
import QuestionsForm from '../../../components/QuestionsForm.astro';
import QuestionsList from '../../../components/QuestionsList.astro';
import headshot from '../../../assets/mladen-head-2020.jpg';
import { workshop, isBeforeStart, isRegistrationOpen } from '../../../data/workshop';
import { fullDate } from '../../../lib/dates';
import { breadcrumbNode, eventNode, graph, personNode } from '../../../lib/schema';

/** Asked at render time, not at module scope: see isRegistrationOpen. */
const registrationOpen = isRegistrationOpen();

/** Three states, not two (MM-74): registration open, registration closed but
 *  the workshop still ahead, and the workshop given. In the third the page
 *  stops asking anything of the reader — no form, no seats count — and becomes
 *  the archive it will stay. The page is prerendered, so the switch happens on
 *  the first build after the cut-off; the roadmap carries that rebuild. */
const beforeStart = isBeforeStart();

const headshotFile = await getImage({
  src: headshot,
  width: 560,
  height: 560,
  format: 'webp',
});

/** The Person node travels with the Event so its performer and organizer
 *  references resolve inside this page's own graph. */
const schema = graph(
  eventNode(Astro.site),
  personNode(Astro.site, headshotFile.src),
  breadcrumbNode(Astro.site, [
    { name: 'Home', path: '/' },
    { name: 'Speaking', path: '/speaking/' },
    { name: '2026', path: '/speaking/2026/' },
    { name: workshop.wordcampName, path: workshop.path },
  ]),
);
---

<BaseLayout
  title={workshop.title}
  description={workshop.summary}
  canonical={workshop.path}
  ogType="article"
>
  <StructuredData slot="head" data={schema} />

  <article>
    <section class="section section--compact" aria-labelledby="workshop-title">
      <div class="container container--narrow flow">
        {
          /* The conference first and in bold: this page is one session of
             WordCamp Belgrade 2026, and the eyebrow should say so before it
             says what kind of session it is. */
        }
        <p class="eyebrow"><strong>{workshop.wordcampName}</strong> · Workshop</p>
        <h1 id="workshop-title">{workshop.title}</h1>
        <Facts />
        {
          /* Seats left, in two places: here, where someone decides whether to
             read on, and above the form, where they decide whether to fill it
             in. The page is static, so what is built into the line is the plain
             fact of how big the room is; the script replaces it with the count
             from /api/seats/ once the page has loaded (MM-71). Both lines go
             once the workshop has been given: there is nothing left to take a
             seat for (MM-74). */
        }
        {
          beforeStart && (
            <p class="seats" data-seats>
              {workshop.capacity} seats
            </p>
          )
        }
        {workshop.abstract.map((paragraph) => <p set:html={paragraph} />)}
      </div>
    </section>

    <section class="section section--compact" aria-labelledby="audience-title">
      <div class="container container--narrow flow">
        <h2 id="audience-title">Who it is for</h2>
        <p set:html={workshop.audience} />
      </div>
    </section>

    {
      /* Three ways to follow (MM-79): the workshop asks for a prepared laptop
         only from the people who want one, and this says so before the
         prerequisites start listing what to install. */
    }
    <section class="section section--compact" aria-labelledby="ways-title">
      <div class="container container--narrow flow">
        <h2 id="ways-title">Three ways to follow</h2>
        <ul>
          {workshop.waysToFollow.map((way) => <li set:html={way} />)}
        </ul>
      </div>
    </section>

    <section class="section section--compact" aria-labelledby="prerequisites-title">
      <div class="container container--narrow flow">
        <h2 id="prerequisites-title">Prerequisites</h2>
        <p>It is perfectly fine to just watch, follow along and ask.</p>
        <p>
          All of these are mandatory if you want to work along on your own laptop. We will
          not have enough time to install it all in the workshop, so please follow the{' '}
          <a href={workshop.repoUrl}>preparation guide on GitHub</a>.
        </p>
        <ul>
          {workshop.prerequisites.map((item) => <li set:html={item} />)}
        </ul>
        <p>{workshop.optionalPrerequisite}</p>
        <p>
          <Fragment set:html={workshop.osNote.before} /> <code>{workshop.osNote.command}</code>{' '}
          {workshop.osNote.after}
        </p>
      </div>
    </section>

    {
      /* Resources (MM-79): every link this workshop has, in one place and in
         the order someone needs them — register, prepare, then the slides and
         the session's own page on the WordCamp site. The registration line is
         only there while the form is: an anchor to a band that no longer holds
         a form would be a dead end. */
    }
    <section class="section section--compact" aria-labelledby="resources-title">
      <div class="container container--narrow flow">
        <h2 id="resources-title">Resources</h2>
        <ul>
          <li>
            <a href={workshop.repoUrl}>Preparation guide and repository</a>
          </li>
          <li>
            <a href={workshop.slidesSpeakerDeck}>Slides on Speaker Deck</a>
          </li>
          <li>
            <a href={workshop.slidesGoogle}>Slides on Google Slides</a>
          </li>
          <li>
            <a href={workshop.sessionUrl}>Session page at {workshop.wordcampName}</a>
          </li>
        </ul>
      </div>
    </section>

    {
      /* Live questions (MM-85). The band is built into every copy of the page
         and hidden; the script reveals it when /api/questions/stream/ says
         questions are open, which is Mladen's own switch from the room. It
         sits between the Resources list and the registration band, so during
         the workshop the two things a participant is asked to do — ask, and
         register — stand next to each other.

         The list below the form is empty in the build: it is filled from the
         stream, and with JavaScript off the whole band never appears. */
    }
    <section
      id="questions"
      class="section section--alt section--compact"
      aria-labelledby="questions-title"
      hidden
    >
      <div class="container container--narrow flow">
        {/* draft: Mladen to approve — the heading and the line under it. */}
        <h2 id="questions-title">Questions</h2>
        <p>Ask during the workshop; questions appear on the screen in the order they arrive.</p>
        <QuestionsForm />
        <QuestionsList />
      </div>
    </section>
    {
      /* Turnstile's loader, for the one state in which the registration form
         is no longer on the page: the widget in the questions form still needs
         it, and the registration form is what normally brings it. Loading
         api.js twice would leave two copies racing to render the same
         containers, so it is never emitted while both forms are here. */
      !registrationOpen && (
        <script
          is:inline
          src="https://challenges.cloudflare.com/turnstile/v0/api.js"
          async
          defer
        />
      )
    }

    {
      /* id="register": every "Register for the workshop" link on the site
         points at this band, not at the top of the page. */
    }
    <section
      id="register"
      class="section section--alt section--compact"
      aria-labelledby="register-title"
    >
      <div class="container container--narrow flow">
        {
          /* The heading follows the state: while the session is ahead this band
             is about registering, and afterwards it is the note about what the
             page will carry next.
             draft: Mladen to approve — the heading and the notice below. */
        }
        <h2 id="register-title">{beforeStart ? 'Registration' : 'After the workshop'}</h2>
        {
          registrationOpen ? (
            <Fragment>
              {
                /* Everything the band asks of a visitor sits in one
                   collapsible group (MM-85), so Mladen can fold the whole
                   registration away from the room the moment the last seat is
                   given out: the stream's `registration_open` flag closes it,
                   and the script puts the "Registration is closed" line next
                   to the folded summary. Open in the build and with JavaScript
                   off, which is the state the endpoint's own rule still backs.
                   The h2 stays outside the group: the heading of the band is
                   not part of what folds. */
              }
              <details class="registration flow" open data-registration>
                <summary>Registration</summary>
                {
                  /* The line says 12:30; the form itself is closed live, by a
                     rebuild from the room, and the endpoint stays open until
                     the workshop ends (MM-80, MM-81). */
                }
                <p>
                  Registration closes{' '}
                  <time datetime={workshop.closesLine}>{workshop.closesLineText}</time>.
                </p>
                <p class="seats" data-seats>
                  {workshop.capacity} seats
                </p>
                <RegistrationForm />
              </details>
            </Fragment>
          ) : (
            <p class="notice">
              The workshop has taken place. Slides and the recording will appear here.
            </p>
          )
        }
      </div>
    </section>
  </article>
  {
    /* The page's one inline script, hashed in the CSP (npm run check:csp). It
       reveals the copy buttons on the SSH-key hint, fills in how many seats are
       left from /api/seats/, hides the laptop-only part of the registration
       form while the watch-only box is ticked, submits that form without
       leaving the page, and — from MM-85 — keeps the live questions band in
       step with /api/questions/stream/. Everything below is enhancement: with
       JavaScript off the copy buttons stay hidden, the seats line says how big
       the room is, every field is visible, the questions band never appears at
       all, and the registration form posts to /api/register/ as a form always
       has.

       The registration half is the same block as on /contact/, on purpose: one
       script per page keeps the CSP to one hash per page, and the endpoints
       answer both forms the same way. The questions half talks to an endpoint
       that answers JSON instead, because there is no server-rendered page for
       it to lift an answer out of. */
  }
  <script is:inline>
    (() => {
      /* Copy buttons: revealed only where the clipboard API exists. Wired again
         after the form is re-rendered, because a re-render brings new buttons
         with no listeners on them. */
      const enhance = () => {
        if (!navigator.clipboard) return;
        for (const button of document.querySelectorAll('button[data-copy]')) {
          button.hidden = false;
          button.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(button.dataset.copy);
              button.classList.add('copy__button--done');
              setTimeout(() => button.classList.remove('copy__button--done'), 1200);
            } catch {}
          });
        }
      };

      /* The watch-only switch. Someone who is not bringing a laptop is not
         asked about one: the blocks marked data-laptop-only are hidden while
         the box is ticked. Hidden, not emptied — whatever was typed comes back
         the moment the box is unticked, and the endpoint is the one that
         decides a watch-only registration carries no laptop answers. */
      const laptopFields = () => {
        const box = document.querySelector('#watch_only');
        if (!box) return;
        const apply = () => {
          const group = document.querySelector('details.advanced');
          if (group) group.open = !box.checked;
        };
        box.addEventListener('change', apply);
        apply();
      };

      /* Everything that has to be done again after the form is re-rendered: a
         swap brings new markup with no listeners on it. */
      const wire = () => {
        enhance();
        laptopFields();
      };

      wire();

      /* Turnstile keeps one widget per container. A container it has already
         filled — Turnstile renders the widget into a child of its own — is
         reset; an empty one, which is what new markup brings, has to be
         rendered into. Shared by both forms on the page. */
      const challenge = (form) => {
        const box = form.querySelector('.cf-turnstile');
        if (!box || !window.turnstile) return;
        if (box.firstElementChild) window.turnstile.reset(box);
        else {
          window.turnstile.render(box, { sitekey: box.dataset.sitekey, theme: box.dataset.theme });
        }
      };

      const submitting = (form, state) => {
        const button = form.querySelector('[type="submit"]');
        if (button) button.disabled = state;
      };

      /* Seats left. The page is static and cached, so the only current number
         on it comes from /api/seats/ after the page has loaded. Anything less
         than a clean answer leaves the built-in line alone: "30 seats for
         working on your own laptop" is true whatever the endpoint says. When the last seat has gone the watch-only
         box is ticked for the visitor — the server would place them as a
         watcher anyway, and the form should say so before they fill it in. */
      const seats = async () => {
        const lines = document.querySelectorAll('[data-seats]');
        if (lines.length === 0) return;

        let answer;
        try {
          const response = await fetch('/api/seats/', {
            headers: { Accept: 'application/json' },
          });
          if (!response.ok) return;
          answer = await response.json();
        } catch {
          return;
        }
        if (typeof answer.left !== 'number' || typeof answer.capacity !== 'number') return;

        const text =
          answer.left === 0
            ? `All ${answer.capacity} seats are taken; ` +
              `you can still register to watch`
            : `${answer.left} of ${answer.capacity} seats left`;
        for (const line of lines) line.textContent = text;

        if (answer.left > 0) return;
        const box = document.querySelector('#watch_only');
        if (box && !box.checked) {
          box.checked = true;
          box.dispatchEvent(new Event('change'));
        }
      };

      seats();

      /* Submitting the registration form without leaving the page. The
         endpoint keeps answering with a whole rendered page — the very one a
         submission without JavaScript lands on — and this lifts out of it the
         part that changed: the success block, or the form carrying its errors
         and the values that were typed. The rendering path stays on the server
         either way.

         The selector names the form: since MM-85 the questions form is on this
         page too, and it is answered in JSON by an endpoint of its own. */
      const registration = () => {
        const form = document.querySelector('[data-form-root="register"]');
        if (!form) return;

        const pristine = form.innerHTML;
        let notice = null;

        /* The one block above the form: replaced on every attempt and focused,
           so the answer is both read out and scrolled to. */
        const answer = (block, role) => {
          if (notice) notice.remove();
          notice = block;
          block.classList.add('notice--live');
          block.setAttribute('role', role);
          block.tabIndex = -1;
          form.before(block);
          block.focus();
        };

        const failed = (text) => {
          const block = document.createElement('p');
          block.className = 'notice notice--error';
          block.textContent = text || form.dataset.fail;
          return block;
        };

        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          submitting(form, true);

          try {
            const response = await fetch(form.action, {
              method: 'POST',
              body: new FormData(form),
              headers: { 'X-Requested-With': 'fetch' },
              credentials: 'same-origin',
            });
            const page = new DOMParser().parseFromString(await response.text(), 'text/html');
            const success = page.querySelector('[data-form-success]');
            const again = page.querySelector('[data-form-root]');
            const closed = page.querySelector('[data-form-closed]');

            if (closed) {
              /* Registration closed since this page was built: the notice
                 takes the form's place, as a rebuild would have done. */
              const notice = document.importNode(closed, true);
              notice.setAttribute('role', 'status');
              notice.setAttribute('tabindex', '-1');
              form.replaceWith(notice);
              notice.focus();
              return;
            }

            if (response.ok && success) {
              form.innerHTML = pristine;
              wire();
              answer(document.importNode(success, true), 'status');
            } else if (again) {
              /* The general message moves above the form; the fields keep the
                 errors beside them and the values that were typed. */
              const general = again.querySelector('.notice--error');
              const text = (general ?? again.querySelector('.field__error'))?.textContent.trim();
              if (general) general.remove();
              form.innerHTML = again.innerHTML;
              wire();
              answer(failed(text), 'alert');
            } else {
              answer(failed(), 'alert');
            }
          } catch {
            answer(failed(), 'alert');
          }

          challenge(form);
          submitting(form, false);
        });
      };

      registration();

      /* Live questions (MM-85). One EventSource on /api/questions/stream/
         carries everything the room needs: a `state` event with the two
         switches Mladen flips from the stage and whether this visitor is the
         host, and a `questions` event with the whole list every time it
         changes. Nothing is polled and nothing is rendered on the server: the
         page is static, and the list below is written here.

         Reconnection is the browser's own — EventSource retries a dropped
         stream by itself, which is what carries the page over the half-hourly
         close of a long-lived connection — so no `error` handler is wired: a
         gap in the stream is not something the room needs to be told about.
         Where EventSource does not exist the band simply stays hidden. */
      const live = () => {
        const band = document.querySelector('#questions');
        const form = document.querySelector('[data-form-root="questions"]');
        const list = document.querySelector('[data-questions-list]');
        const coveredGroup = document.querySelector('[data-questions-covered]');
        const coveredList = coveredGroup?.querySelector('ol');
        const countLine = document.querySelector('[data-questions-count]');
        const group = document.querySelector('[data-registration]');
        if (!band || !form || !list || !countLine || !window.EventSource) return;

        const nameField = form.querySelector('#q-name');
        const bodyField = form.querySelector('#q-body');

        /* The host flag rides on every state event; the list is rendered
           differently for the one person who can tick a question off. */
        let host = false;
        let revealed = false;
        let closedLine = null;

        /* The room's own clock, whoever is looking and wherever they are. */
        const clock = new Intl.DateTimeFormat('en-GB', {
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
          timeZone: 'Europe/Belgrade',
        });

        const cover = async (id, covered, button) => {
          button.disabled = true;
          const body = new FormData();
          body.append('id', id);
          body.append('covered', covered);
          try {
            await fetch('/api/questions/cover/', {
              method: 'POST',
              body,
              headers: { 'X-Requested-With': 'fetch' },
              credentials: 'same-origin',
            });
          } catch {}
          /* The stream sends the whole list back after a change, so there is
             nothing to re-render here; the button is only re-enabled in case
             the request never arrived. */
          button.disabled = false;
        };

        const item = (question, covered) => {
          const entry = document.createElement('li');
          entry.dataset.id = question.id;

          const body = document.createElement('p');
          body.className = 'questions__body';
          body.textContent = question.body;
          entry.append(body);

          const meta = document.createElement('p');
          meta.className = 'questions__meta';
          const at = Date.parse(question.createdAt);
          const who = question.name || 'Anonymous';
          meta.textContent = Number.isNaN(at) ? who : `${who} · ${clock.format(at)}`;
          entry.append(meta);

          if (host) {
            const tick = document.createElement('button');
            tick.type = 'button';
            tick.className = 'questions__tick';
            tick.textContent = covered ? 'Uncover' : 'Covered';
            tick.addEventListener('click', () => cover(question.id, covered ? '0' : '1', tick));
            entry.append(tick);
          }

          return entry;
        };

        /* Covered questions leave the list for everyone. Only the host has
           anywhere to see them afterwards. */
        const render = (questions) => {
          const open = questions.filter((question) => !question.covered);
          const covered = questions.filter((question) => question.covered);

          list.replaceChildren(...open.map((question) => item(question, false)));

          if (coveredGroup && coveredList) {
            coveredGroup.hidden = !host || covered.length === 0;
            coveredList.replaceChildren(
              ...(host ? covered.map((question) => item(question, true)) : []),
            );
          }

          countLine.textContent = host
            ? `${open.length} open · ${covered.length} covered`
            : open.length === 0
              ? 'No questions yet'
              : open.length === 1
                ? '1 question'
                : `${open.length} questions`;
        };

        /* A closed registration folds the group away. The line that says so has
           to sit beside it rather than inside it: a folded details shows its
           summary and nothing else. It is made once and hidden again if
           registration reopens. */
        const registrationState = (open) => {
          if (!group) return;
          group.open = open;
          if (open && !closedLine) return;
          if (!closedLine) {
            closedLine = document.createElement('p');
            closedLine.className = 'notice';
            closedLine.textContent = 'Registration is closed';
            group.after(closedLine);
          }
          closedLine.hidden = open;
        };

        const state = (data) => {
          host = data.host === true;
          band.hidden = data.questionsOpen !== true;
          registrationState(data.registrationOpen === true);

          /* Turnstile cannot measure a widget inside a display:none band, so
             the one in the questions form is rendered the first time the band
             is actually shown. */
          if (!band.hidden && !revealed) {
            revealed = true;
            challenge(form);
          }
        };

        /* The form's own answers. Field errors go next to their field, the
           rest above the form as a status line that takes itself away again —
           during a workshop nobody should have to dismiss anything. */
        let notice = null;

        const say = (text, kind, role) => {
          if (notice) notice.remove();
          notice = document.createElement('p');
          notice.className = `notice notice--${kind} notice--live`;
          notice.setAttribute('role', role);
          notice.textContent = text;
          form.before(notice);
          const shown = notice;
          setTimeout(() => shown.remove(), 4000);
        };

        const clearErrors = () => {
          for (const line of form.querySelectorAll('.field__error')) line.remove();
          for (const field of [nameField, bodyField]) {
            field?.removeAttribute('aria-invalid');
            field?.removeAttribute('aria-describedby');
          }
        };

        const fieldError = (field, message) => {
          if (!field) return;
          const line = document.createElement('p');
          line.className = 'field__error';
          line.id = `${field.id}-error`;
          line.textContent = message;
          field.setAttribute('aria-invalid', 'true');
          field.setAttribute('aria-describedby', line.id);
          field.after(line);
        };

        try {
          const remembered = localStorage.getItem('mm_name');
          if (remembered && nameField && nameField.value === '') nameField.value = remembered;
        } catch {}

        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          submitting(form, true);
          clearErrors();

          try {
            const response = await fetch(form.action, {
              method: 'POST',
              body: new FormData(form),
              headers: { 'X-Requested-With': 'fetch', Accept: 'application/json' },
              credentials: 'same-origin',
            });

            let answer = null;
            try {
              answer = await response.json();
            } catch {}

            if (response.ok && answer?.ok) {
              /* The question goes, the name stays: the next one is from the
                 same person, and the browser remembers it for the next
                 visit. */
              if (bodyField) bodyField.value = '';
              if (nameField && nameField.value !== '') {
                try {
                  localStorage.setItem('mm_name', nameField.value);
                } catch {}
              }
              say('Asked', 'ok', 'status');
            } else {
              const errors = answer?.errors ?? {};
              let beside = 0;
              if (errors.name) {
                fieldError(nameField, errors.name);
                beside += 1;
              }
              if (errors.body) {
                fieldError(bodyField, errors.body);
                beside += 1;
              }
              if (errors.form) say(errors.form, 'error', 'alert');
              else if (beside === 0) say(form.dataset.fail, 'error', 'alert');
            }
          } catch {
            say(form.dataset.fail, 'error', 'alert');
          }

          challenge(form);
          submitting(form, false);
        });

        const stream = new EventSource('/api/questions/stream/');
        stream.addEventListener('state', (event) => {
          try {
            state(JSON.parse(event.data));
          } catch {}
        });
        stream.addEventListener('questions', (event) => {
          try {
            render(JSON.parse(event.data));
          } catch {}
        });
      };

      live();
    })();
  </script>
</BaseLayout>
