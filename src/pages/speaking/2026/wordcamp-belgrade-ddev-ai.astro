---
import { getImage } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StructuredData from '../../../components/StructuredData.astro';
import Facts from '../../../components/Facts.astro';
import RegistrationForm from '../../../components/RegistrationForm.astro';
import QuestionsForm from '../../../components/QuestionsForm.astro';
import QuestionsList from '../../../components/QuestionsList.astro';
import WorkshopScript from '../../../components/WorkshopScript.astro';
import headshot from '../../../assets/mladen-head-2020.jpg';
import { workshop, isBeforeStart, isRegistrationOpen } from '../../../data/workshop';
import { fullDate } from '../../../lib/dates';
import { breadcrumbNode, eventNode, graph, personNode } from '../../../lib/schema';

/** Asked at render time, not at module scope: see isRegistrationOpen. */
const registrationOpen = isRegistrationOpen();

/** Three states, not two (MM-74): registration open, registration closed but
 *  the workshop still ahead, and the workshop given. In the third the page
 *  stops asking anything of the reader — no form, no seats count — and becomes
 *  the archive it will stay. The page is prerendered, so the switch happens on
 *  the first build after the cut-off; the roadmap carries that rebuild. */
const beforeStart = isBeforeStart();

/** While the workshop is still ahead or running, the page carries the Register
 *  row, the seats, the ticket notice, the Questions band, the Registration
 *  band and their script. Once it is over none of them is rendered and the
 *  page ends with Resources (MM-95); the components and endpoints stay in the
 *  repo for the next workshop. */
const live = registrationOpen;

const headshotFile = await getImage({
  src: headshot,
  width: 560,
  height: 560,
  format: 'webp',
});

/** The Person node travels with the Event so its performer and organizer
 *  references resolve inside this page's own graph. */
const schema = graph(
  eventNode(Astro.site),
  personNode(Astro.site, headshotFile.src),
  breadcrumbNode(Astro.site, [
    { name: 'Home', path: '/' },
    { name: 'Speaking', path: '/speaking/' },
    { name: '2026', path: '/speaking/2026/' },
    { name: workshop.wordcampName, path: workshop.path },
  ]),
);
---

<BaseLayout
  title={workshop.title}
  description={workshop.summary}
  canonical={workshop.path}
  ogType="article"
>
  <StructuredData slot="head" data={schema} />

  <article>
    <section class="section section--compact" aria-labelledby="workshop-title">
      <div class="container container--narrow flow">
        {
          /* The conference first and in bold: this page is one session of
             WordCamp Belgrade 2026, and the eyebrow should say so before it
             says what kind of session it is. */
        }
        <p class="eyebrow"><strong>{workshop.wordcampName}</strong> · Workshop</p>
        <h1 id="workshop-title">{workshop.title}</h1>
        <Facts />
        {
          /* Seats left, in two places: here, where someone decides whether to
             read on, and above the form, where they decide whether to fill it
             in. The page is static, so what is built into the line is the plain
             fact of how big the room is; the script replaces it with the count
             from /api/seats/ once the page has loaded (MM-71). Both lines go
             once the workshop has been given: there is nothing left to take a
             seat for (MM-74). */
        }
        {
          beforeStart && (
            <Fragment>
              <div class="row">
                <a class="button" href="#register">Register</a>
                <p class="seats" data-seats>
                  {workshop.capacity} seats
                </p>
              </div>
              <p class="notice">
                This registration is for the workshop only. To be at WordCamp Belgrade you need
                a <a href={workshop.ticketsUrl}>WordCamp ticket</a> first.
              </p>
            </Fragment>
          )
        }
        {workshop.abstract.map((paragraph) => <p set:html={paragraph} />)}
      </div>
    </section>

    <section class="section section--compact" aria-labelledby="audience-title">
      <div class="container container--narrow flow">
        <h2 id="audience-title">Who it is for</h2>
        <p set:html={workshop.audience} />
      </div>
    </section>

    {
      /* Three ways to follow (MM-79): the workshop asks for a prepared laptop
         only from the people who want one, and this says so before the
         prerequisites start listing what to install. */
    }
    <section class="section section--compact" aria-labelledby="ways-title">
      <div class="container container--narrow flow">
        <h2 id="ways-title">Three ways to follow</h2>
        <ul>
          {workshop.waysToFollow.map((way) => <li set:html={way} />)}
        </ul>
      </div>
    </section>

    <section class="section section--compact" aria-labelledby="prerequisites-title">
      <div class="container container--narrow flow">
        <h2 id="prerequisites-title">Prerequisites</h2>
        <p>It is perfectly fine to just watch, follow along and ask.</p>
        <p>
          All of these are mandatory if you want to work along on your own laptop. We will
          not have enough time to install it all in the workshop, so please follow the{' '}
          <a href={workshop.repoUrl}>preparation guide on GitHub</a>.
        </p>
        <ul>
          {workshop.prerequisites.map((item) => <li set:html={item} />)}
        </ul>
        <p>{workshop.optionalPrerequisite}</p>
        <p>
          <Fragment set:html={workshop.osNote.before} /> <code>{workshop.osNote.command}</code>{' '}
          {workshop.osNote.after}
        </p>
      </div>
    </section>

    {
      /* Resources (MM-79): every link this workshop has, in one place and in
         the order someone needs them — register, prepare, then the slides and
         the session's own page on the WordCamp site. The registration line is
         only there while the form is: an anchor to a band that no longer holds
         a form would be a dead end. */
    }
    <section class="section section--compact" aria-labelledby="resources-title">
      <div class="container container--narrow flow">
        <h2 id="resources-title">Resources</h2>
        <ul>
          <li>
            <a href={workshop.repoUrl}>Preparation guide and repository</a>
          </li>
          <li>
            <a href={workshop.slidesSpeakerDeck}>Slides on Speaker Deck</a>
          </li>
          <li>
            <a href={workshop.slidesGoogle}>Slides on Google Slides</a>
          </li>
          <li>
            <a href={workshop.sessionUrl}>Session page at {workshop.wordcampName}</a>
          </li>
        </ul>
      </div>
    </section>

    {
      /* Live questions (MM-85). The band is built into every copy of the page
         and hidden; the script reveals it when /api/questions/stream/ says
         questions are open, which is Mladen's own switch from the room. It
         sits between the Resources list and the registration band, so during
         the workshop the two things a participant is asked to do — ask, and
         register — stand next to each other.

         The list below the form is empty in the build: it is filled from the
         stream, and with JavaScript off the whole band never appears. */
    }
    {
      live && (
    <section
      id="questions"
      class="section section--compact"
      aria-labelledby="questions-title"
      hidden
    >
      <div class="container container--narrow flow">
        {/* draft: Mladen to approve — the heading and the line under it. */}
        <h2 id="questions-title">Questions</h2>
        <p>Ask during the workshop; questions appear on the screen in the order they arrive.</p>
        <QuestionsForm />
        <QuestionsList />
      </div>
    </section>
      )
    }
    {
      /* id="register": every "Register for the workshop" link on the site
         points at this band, not at the top of the page. */
    }
    {
      live && (
    <section
      id="register"
      class="section section--alt section--compact"
      aria-labelledby="register-title"
    >
      <div class="container container--narrow flow">
        {
          /* The heading follows the state: while the session is ahead this band
             is about registering, and afterwards it is the note about what the
             page will carry next.
             draft: Mladen to approve — the heading and the notice below.

             Beside it, the host's one control (MM-88), hidden in every copy of
             the page and revealed only when the stream says this visitor is the
             host — the same cookie that shows the cover buttons. One switch for
             the whole day: turning the questions on is also what folds the
             registration away, because by then the band is no longer what the
             room is here for. The switch's own state is written from the
             stream's `state` event and never from the tap, so what it shows is
             what the room is being served; if a flip does not land, the switch
             does not move. The People link is the host's way to the list of who
             registered (MM-89). */
        }
        <div class="register__head">
          <h2 id="register-title">{beforeStart ? 'Registration' : 'After the workshop'}</h2>
          <span class="hostctl" data-hostctl hidden>
            <button
              type="button"
              class="switch"
              role="switch"
              aria-checked="false"
              data-flip="questions_open"
            >
              <span class="switch__label">Questions</span>
              <span class="switch__track" aria-hidden="true"></span>
            </button>
            <a class="hostctl__link" href={`${workshop.path}people/`}>People</a>
          </span>
        </div>
        {
          registrationOpen ? (
            <Fragment>
              {
                /* Everything the band asks of a visitor sits in one
                   collapsible group (MM-85), so the whole registration can fold
                   away from the room the moment the workshop starts: from
                   MM-88 the switch that opens the questions is what folds it,
                   and nothing else on the page says so — the group is still
                   there to open, and the endpoint is still taking people. Open
                   in the build and with JavaScript off, which is the state the
                   endpoint's own rule still backs. The h2 stays outside the
                   group: the heading of the band is not part of what folds. */
              }
              <details class="registration flow" open data-registration>
                <summary>The form</summary>
                {
                  /* The line says 12:30; the form itself is closed live, by a
                     rebuild from the room, and the endpoint stays open until
                     the workshop ends (MM-80, MM-81). */
                }
                {/* draft: Mladen to approve — the ticket comes first (MM-91). */}
                <p class="notice">
                  This registration is for the workshop only. To be at WordCamp Belgrade you need a{' '}
                  <a href={workshop.ticketsUrl}>WordCamp ticket</a> first.
                </p>
                <p>
                  Registration closes{' '}
                  <time datetime={workshop.closesLine}>{workshop.closesLineText}</time>.
                </p>
                <p class="seats" data-seats>
                  {workshop.capacity} seats
                </p>
                <RegistrationForm />
              </details>
            </Fragment>
          ) : (
            <p class="notice">
              The workshop has taken place. Slides and the recording will appear here.
            </p>
          )
        }
      </div>
    </section>
      )
    }
  </article>
  {
    /* The page's one inline script, hashed in the CSP (npm run check:csp). It
       reveals the copy buttons on the SSH-key hint, fills in how many seats are
       left from /api/seats/, hides the laptop-only part of the registration
       form while the watch-only box is ticked, submits that form without
       leaving the page, keeps the live questions band in step with
       /api/questions/stream/ (MM-85) and, from MM-88, drives the host's one
       switch. Everything below is enhancement: with JavaScript off the copy
       buttons stay hidden, the seats line says how big the room is, every field
       is visible, neither the questions band nor the host's switch ever
       appears, the registration group stays unfolded, and the registration form
       posts to /api/register/ as a form always has.

       The registration half is the same block as on /contact/, on purpose: one
       script per page keeps the CSP to one hash per page, and the endpoints
       answer both forms the same way. The questions half talks to an endpoint
       that answers JSON instead, because there is no server-rendered page for
       it to lift an answer out of. */
  }
  {live && <WorkshopScript />}
</BaseLayout>
