---
import { getImage } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StructuredData from '../../../components/StructuredData.astro';
import Facts from '../../../components/Facts.astro';
import RegistrationForm from '../../../components/RegistrationForm.astro';
import RegistrationClosed from '../../../components/RegistrationClosed.astro';
import headshot from '../../../assets/mladen-head-2020.jpg';
import { workshop, isRegistrationOpen } from '../../../data/workshop';
import { fullDate } from '../../../lib/dates';
import { breadcrumbNode, eventNode, graph, personNode } from '../../../lib/schema';

/** Asked at render time, not at module scope: see isRegistrationOpen. */
const registrationOpen = isRegistrationOpen();

const headshotFile = await getImage({
  src: headshot,
  width: 560,
  height: 560,
  format: 'webp',
});

/** The Person node travels with the Event so its performer and organizer
 *  references resolve inside this page's own graph. */
const schema = graph(
  eventNode(Astro.site),
  personNode(Astro.site, headshotFile.src),
  breadcrumbNode(Astro.site, [
    { name: 'Home', path: '/' },
    { name: 'Speaking', path: '/speaking/' },
    { name: '2026', path: '/speaking/2026/' },
    { name: workshop.wordcampName, path: workshop.path },
  ]),
);
---

<BaseLayout
  title={workshop.title}
  description={workshop.summary}
  canonical={workshop.path}
  ogType="article"
>
  <StructuredData slot="head" data={schema} />

  <article>
    <section class="section section--compact" aria-labelledby="workshop-title">
      <div class="container container--narrow flow">
        {
          /* The conference first and in bold: this page is one session of
             WordCamp Belgrade 2026, and the eyebrow should say so before it
             says what kind of session it is. */
        }
        <p class="eyebrow"><strong>{workshop.wordcampName}</strong> · Workshop</p>
        <h1 id="workshop-title">{workshop.title}</h1>
        <Facts />
        {
          /* Seats left, in two places: here, where someone decides whether to
             read on, and above the form, where they decide whether to fill it
             in. The page is static, so what is built into the line is the plain
             fact of how big the room is; the script replaces it with the count
             from /api/seats/ once the page has loaded (MM-71). */
        }
        <p class="seats" data-seats>{workshop.capacity} seats</p>
        {workshop.abstract.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="section section--compact" aria-labelledby="audience-title">
      <div class="container container--narrow flow">
        <h2 id="audience-title">Who it is for</h2>
        <p>{workshop.audience}</p>
      </div>
    </section>

    <section class="section section--compact" aria-labelledby="prerequisites-title">
      <div class="container container--narrow flow">
        <h2 id="prerequisites-title">Prerequisites</h2>
        <p>It is perfectly fine to just watch, follow along and ask.</p>
        <p>
          All of these are mandatory if you want to work along on your own laptop. We will
          not have enough time to install it all in the workshop, so please follow the{' '}
          <a href={workshop.repoUrl}>preparation guide on GitHub</a>.
        </p>
        <ul>
          {workshop.prerequisites.map((item) => <li>{item}</li>)}
        </ul>
        <p>{workshop.optionalPrerequisite}</p>
        <p>Preparation guide and materials will be on GitHub by {workshop.prepDeadline}.</p>
      </div>
    </section>

    {
      /* id="register": every "Register for the workshop" link on the site
         points at this band, not at the top of the page. */
    }
    <section
      id="register"
      class="section section--alt section--compact"
      aria-labelledby="register-title"
    >
      <div class="container container--narrow flow">
        <h2 id="register-title">Registration</h2>
        {
          registrationOpen ? (
            <Fragment>
              <p>
                Registration closes{' '}
                <time datetime={workshop.closeDate}>{fullDate(workshop.closesAt)}</time>.
              </p>
              <p class="seats" data-seats>{workshop.capacity} seats</p>
              <RegistrationForm />
            </Fragment>
          ) : (
            <RegistrationClosed />
          )
        }
      </div>
    </section>
  </article>
  {
    /* The page's one inline script, hashed in the CSP (npm run check:csp). It
       does four things: it reveals the copy buttons on the SSH-key hint, it
       fills in how many seats are left from /api/seats/, it hides the
       laptop-only part of the registration form while the watch-only box is
       ticked, and it submits the form without leaving the page. Everything
       below is enhancement — with JavaScript off the copy buttons stay hidden,
       the seats line says how big the room is, every field is visible, and the
       form posts to /api/register/ as a form always has.

       The second half is the same block as on /contact/, on purpose: one script
       per page keeps the CSP to one hash per page, and the endpoints answer
       both forms the same way. */
  }
  <script is:inline>
    (() => {
      /* Copy buttons: revealed only where the clipboard API exists. Wired again
         after the form is re-rendered, because a re-render brings new buttons
         with no listeners on them. */
      const enhance = () => {
        if (!navigator.clipboard) return;
        for (const button of document.querySelectorAll('button[data-copy]')) {
          button.hidden = false;
          button.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(button.dataset.copy);
              button.classList.add('copy__button--done');
              setTimeout(() => button.classList.remove('copy__button--done'), 1200);
            } catch {}
          });
        }
      };

      /* The watch-only switch. Someone who is not bringing a laptop is not
         asked about one: the blocks marked data-laptop-only are hidden while
         the box is ticked. Hidden, not emptied — whatever was typed comes back
         the moment the box is unticked, and the endpoint is the one that
         decides a watch-only registration carries no laptop answers. */
      const laptopFields = () => {
        const box = document.querySelector('#watch_only');
        if (!box) return;
        const apply = () => {
          for (const part of document.querySelectorAll('[data-laptop-only]')) {
            part.hidden = box.checked;
          }
        };
        box.addEventListener('change', apply);
        apply();
      };

      /* Everything that has to be done again after the form is re-rendered: a
         swap brings new markup with no listeners on it. */
      const wire = () => {
        enhance();
        laptopFields();
      };

      wire();

      /* Seats left. The page is static and cached, so the only current number
         on it comes from /api/seats/ after the page has loaded. Anything less
         than a clean answer leaves the built-in line alone: "30 seats" is true
         whatever the endpoint says. When the last seat has gone the watch-only
         box is ticked for the visitor — the server would place them as a
         watcher anyway, and the form should say so before they fill it in. */
      const seats = async () => {
        const lines = document.querySelectorAll('[data-seats]');
        if (lines.length === 0) return;

        let answer;
        try {
          const response = await fetch('/api/seats/', {
            headers: { Accept: 'application/json' },
          });
          if (!response.ok) return;
          answer = await response.json();
        } catch {
          return;
        }
        if (typeof answer.left !== 'number' || typeof answer.capacity !== 'number') return;

        const text =
          answer.left === 0
            ? `All ${answer.capacity} seats are taken; you can still register to watch`
            : `${answer.left} of ${answer.capacity} seats left`;
        for (const line of lines) line.textContent = text;

        if (answer.left > 0) return;
        const box = document.querySelector('#watch_only');
        if (box && !box.checked) {
          box.checked = true;
          box.dispatchEvent(new Event('change'));
        }
      };

      seats();

      /* Submitting without leaving the page. The endpoint keeps answering with
         a whole rendered page — the very one a submission without JavaScript
         lands on — and this lifts out of it the part that changed: the success
         block, or the form carrying its errors and the values that were typed.
         The rendering path stays on the server either way. */
      const form = document.querySelector('[data-form-root]');
      if (!form) return;

      const pristine = form.innerHTML;
      let notice = null;

      /* The one block above the form: replaced on every attempt and focused, so
         the answer is both read out and scrolled to. */
      const answer = (block, role) => {
        if (notice) notice.remove();
        notice = block;
        block.classList.add('notice--live');
        block.setAttribute('role', role);
        block.tabIndex = -1;
        form.before(block);
        block.focus();
      };

      const failed = (text) => {
        const block = document.createElement('p');
        block.className = 'notice notice--error';
        block.textContent = text || form.dataset.fail;
        return block;
      };

      /* Turnstile keeps one widget per container. A container it has already
         filled — Turnstile renders the widget into a child of its own — is
         reset; an empty one, which is what new markup brings, has to be
         rendered into. */
      const challenge = () => {
        const box = form.querySelector('.cf-turnstile');
        if (!box || !window.turnstile) return;
        if (box.firstElementChild) window.turnstile.reset(box);
        else {
          window.turnstile.render(box, { sitekey: box.dataset.sitekey, theme: box.dataset.theme });
        }
      };

      const submitting = (state) => {
        const button = form.querySelector('[type="submit"]');
        if (button) button.disabled = state;
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        submitting(true);

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'X-Requested-With': 'fetch' },
            credentials: 'same-origin',
          });
          const page = new DOMParser().parseFromString(await response.text(), 'text/html');
          const success = page.querySelector('[data-form-success]');
          const again = page.querySelector('[data-form-root]');
          const closed = page.querySelector('[data-form-closed]');

          if (closed) {
            /* Registration closed since this page was built: the notice
               takes the form's place, as a rebuild would have done. */
            const notice = document.importNode(closed, true);
            notice.setAttribute('role', 'status');
            notice.setAttribute('tabindex', '-1');
            form.replaceWith(notice);
            notice.focus();
            return;
          }

          if (response.ok && success) {
            form.innerHTML = pristine;
            wire();
            answer(document.importNode(success, true), 'status');
          } else if (again) {
            /* The general message moves above the form; the fields keep the
               errors beside them and the values that were typed. */
            const general = again.querySelector('.notice--error');
            const text = (general ?? again.querySelector('.field__error'))?.textContent.trim();
            if (general) general.remove();
            form.innerHTML = again.innerHTML;
            wire();
            answer(failed(text), 'alert');
          } else {
            answer(failed(), 'alert');
          }
        } catch {
          answer(failed(), 'alert');
        }

        challenge();
        submitting(false);
      });
    })();
  </script>
</BaseLayout>
