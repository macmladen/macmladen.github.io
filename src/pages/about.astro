---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import headshot from '../assets/mladen-head-2020.jpg';
import { person } from '../data/person';
import { graph, personNode, profilePageNode } from '../lib/schema';

/** The Person node points at the same 560px headshot the home page renders,
 *  so both pages describe the entity with one image file. */
const headshotFile = await getImage({
  src: headshot,
  width: 560,
  height: 560,
  format: 'webp',
});

const schema = graph(profilePageNode(Astro.site, personNode(Astro.site, headshotFile.src)));

// draft: Mladen to approve — meta description for /about/. Rewritten in MM-30:
// the speaking list moved to /speaking/, so the description no longer promises it.
const description =
  'Senior developer and architect in Novi Sad: the longer story, from assembly on ' +
  '8-bit machines and fifteen years of typography to WordPress, Drupal and the web.';
---

<BaseLayout title="About" description={description} canonical="/about/" ogType="profile">
  <StructuredData slot="head" data={schema} />

  <section class="section" aria-labelledby="about-title">
    <div class="container container--narrow flow flow-root">
      <h1 id="about-title">About</h1>
      <p class="subtitle">This is what I do.</p>
      <Image
        src={headshot}
        width={240}
        height={240}
        densities={[1, 2]}
        format="webp"
        alt="Mladen Djuric"
        loading="lazy"
        class="portrait portrait--float"
      />
      {
        /* Mladen's about text, verbatim. set:html because the paragraphs carry
           inline markup — <strong>, one <code> and the source links; the
           strings are fixed content in src/data/person.ts, not input. */
        person.about.map((paragraph) => (
          <p>
            <Fragment set:html={paragraph} />
          </p>
        ))
      }
      {
        /* The story ends by asking for the work. The topic key is the one stored
           in D1 (src/data/contact.ts), so /contact/ can preselect it. */
      }
      <!-- draft: Mladen to approve — the CTA label at the end of /about/. -->
      <p><a class="button" href="/contact/?topic=website">Request a proposal</a></p>
    </div>
  </section>
</BaseLayout>
