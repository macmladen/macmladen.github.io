---
import { person } from '../data/person';

const nav = [{ label: 'About', href: '/about/' }];
const here = Astro.url.pathname.replace(/\/+$/, '');
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__name" href="/">{person.name}</a>
    <div class="site-header__end">
      <nav aria-label="Main">
        <ul class="site-header__nav">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={here === item.href.replace(/\/+$/, '') ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      {/* Ships hidden; ThemeScript.astro reveals it and wires it, so with
          JavaScript off there is no dead control and the page is Auto. */}
      <div class="theme" id="theme" hidden>
        <label class="visually-hidden" for="theme-choice">Colour scheme</label>
        <select class="theme__control" id="theme-choice">
          <option value="auto">Auto</option>
          <option value="light">Light</option>
          <option value="dark">Dark</option>
        </select>
      </div>
    </div>
  </div>
</header>

<style>
  @layer components {
    /* An ink bar: the colour itself separates it from the page, so it needs
       no bottom rule. Bar links are white and only underline on hover, and
       both hover and focus-visible draw the fuchsia outline, so a pointer and
       a keyboard get the same signal. */
    .site-header {
      background-color: var(--color-bar-bg);
      color: var(--color-bar-ink);
      padding-block: var(--space-4);
    }

    .site-header a {
      color: var(--color-bar-ink);
      text-decoration: none;
    }

    .site-header a:hover,
    .site-header a:active,
    .site-header a:focus-visible {
      color: var(--color-bar-ink);
      outline: var(--focus-width) solid var(--color-bar-hover);
      outline-offset: var(--focus-offset);
    }

    .site-header__inner {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-4);
    }

    /* The wordmark, never underlined — the underline rule below is scoped to
       the nav so it never reaches the name. */
    .site-header__name {
      font-size: var(--text-lg);
      font-weight: var(--weight-bold);
    }

    .site-header__nav a:hover,
    .site-header__nav a:active {
      text-decoration: underline;
    }

    .site-header__end {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-4);
    }

    /* .theme sets no display, so the `hidden` attribute it ships with keeps
       working. The bar is ink in every scheme and so is the control, down to
       the native option list, which follows color-scheme. */
    .theme__control {
      padding: var(--space-1) var(--space-2);
      border: var(--border-width) solid var(--color-bar-ink);
      border-radius: var(--radius-sm);
      background-color: var(--color-bar-bg);
      color: var(--color-bar-ink);
      color-scheme: dark;
      font-size: var(--text-sm);
      cursor: pointer;
    }

    .theme__control:hover,
    .theme__control:focus-visible {
      outline: var(--focus-width) solid var(--color-bar-hover);
      outline-offset: var(--focus-offset);
    }

    .site-header__nav {
      display: flex;
      gap: var(--space-4);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .site-header__nav li + li {
      margin-block-start: 0;
    }

    /* "You are here" carries weight and a rule, not a colour, so it survives
       on an ink bar where every link is already white. */
    .site-header__nav [aria-current='page'] {
      font-weight: var(--weight-semibold);
      text-decoration: underline;
    }
  }
</style>
