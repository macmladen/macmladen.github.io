---
/** A shell command with a copy-to-clipboard button. The command is plain
 *  selectable text; the button only works with the small inline script on the
 *  page that hosts it (see the workshop page), which copies `data-copy`. */
interface Props {
  command: string;
}
const { command } = Astro.props;
---

<span class="copy">
  <code>{command}</code>
  <button type="button" class="copy__button" data-copy={command} aria-label={`Copy: ${command}`} hidden>
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
      <rect x="9" y="9" width="13" height="13" rx="2" />
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
    </svg>
  </button>
</span>
