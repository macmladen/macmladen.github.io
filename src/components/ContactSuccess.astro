---
/** Shown in place of the form once a message is in the database. It says the
 *  message was received, not that the email arrived: delivery is a separate
 *  step whose outcome lands in messages.mail_status, and the visitor's business
 *  is finished either way. The `data-form-success` attribute is the contact
 *  page's handle on it: when the form is submitted with fetch, the script lifts
 *  this very block out of the rendered answer and puts it above the form. */
/** Copy approved by Mladen, 2026-09-10. Props are accepted but unused so the
 *  endpoint's call site stays unchanged. */
interface Props {
  email?: string;
  topic?: string;
}
---

<div class="notice notice--ok flow" data-form-success>
  <p><strong>Thank you, your message has been sent successfully.</strong> Expect an answer soon.</p>
</div>
