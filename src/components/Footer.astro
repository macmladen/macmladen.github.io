---
import { person } from '../data/person';

/** The footer shows the profiles it has a mark for; the rest of
 *  person.profiles still feeds sameAs in the JSON-LD, and person.brands and
 *  person.email are data for the structured data, not footer links.
 *  Both marks are the official brand glyphs on a 24px grid, one path each,
 *  filled with currentColor so they follow the surrounding text. */
const marks: Record<string, string> = {
  LinkedIn:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 ' +
    '2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 ' +
    '4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 ' +
    '2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 ' +
    '13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 ' +
    '24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  GitHub:
    'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 ' +
    '0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 ' +
    '17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 ' +
    '1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 ' +
    '0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 ' +
    '1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 ' +
    '2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 ' +
    '2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 ' +
    '12.297c0-6.627-5.373-12-12-12',
};

const social = person.profiles.filter((profile) => profile.name in marks);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container flow">
    <h2 class="visually-hidden">Elsewhere</h2>
    <ul class="site-footer__links">
      {
        social.map((profile) => (
          <li>
            <a class="site-footer__icon" href={profile.url} rel="me">
              <svg
                viewBox="0 0 24 24"
                width="24"
                height="24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d={marks[profile.name]} />
              </svg>
              <span class="visually-hidden">{profile.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="site-footer__copy">© {year} {person.name}</p>
  </div>
</footer>

<style>
  @layer components {
    .site-footer {
      border-block-start: var(--border-width) solid var(--color-border);
      margin-block-start: var(--space-16);
      padding-block: var(--space-8);
      font-size: var(--text-sm);
    }

    .site-footer__links {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-2);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .site-footer__links li + li {
      margin-block-start: 0;
    }

    /* The mark is the whole link, so there is no text to underline; the
       padding is what makes the tap target bigger than the 24px glyph. */
    .site-footer__icon {
      display: inline-flex;
      padding: var(--space-2);
      text-decoration: none;
    }

    .site-footer__copy {
      color: var(--color-ink-soft);
      text-align: center;
    }
  }
</style>
