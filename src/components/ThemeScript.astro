---
/** The site's colour-scheme state, in one inline script.
 *
 *  It runs in <head>, before the stylesheet is parsed, so the reader's stored
 *  choice is already on <html> when the first paint happens and nothing
 *  flashes. It is `is:inline`, so Astro leaves it exactly where it stands
 *  instead of bundling it into a file the page would have to fetch.
 *
 *  Contract with Header.astro:
 *    #theme         the wrapper, shipped with `hidden`; only this script
 *                   reveals it, so with JavaScript off there is no control
 *                   and the page is Auto
 *    #theme-choice  the <select>, values `auto` | `light` | `dark`
 *
 *  State: localStorage key `theme`. Light and Dark are stored; Auto is the
 *  absence of the key, and the absence of `data-theme` on <html>, which is
 *  what lets the media query in tokens.css decide.
 */
---

<script is:inline>
  (() => {
    const root = document.documentElement;

    /* Storage throws in a locked-down browser; Auto is the right fallback. */
    const read = () => {
      try {
        return localStorage.getItem('theme');
      } catch {
        return null;
      }
    };

    const apply = (value) => {
      if (value === 'light' || value === 'dark') root.dataset.theme = value;
      else delete root.dataset.theme;
    };

    apply(read());

    document.addEventListener('DOMContentLoaded', () => {
      const box = document.getElementById('theme');
      const control = document.getElementById('theme-choice');
      if (!box || !control) return;

      const stored = read();
      control.value = stored === 'light' || stored === 'dark' ? stored : 'auto';

      control.addEventListener('change', () => {
        apply(control.value);
        try {
          if (control.value === 'auto') localStorage.removeItem('theme');
          else localStorage.setItem('theme', control.value);
        } catch {
          /* The choice still applies to this page; it just will not persist. */
        }
      });

      box.hidden = false;
    });
  })();
</script>
