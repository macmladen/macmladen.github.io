---
/** The workshop registration form. Rendered twice: on the static workshop page
 *  with empty props, and by /api/register/ with the values the visitor typed and
 *  the errors the server found, so a failed submission comes back filled in. */
import {
  emptyValues,
  githubPattern,
  osOptions,
  splitTools,
  terminalOptions,
  toolOptions,
  type RegistrationErrors,
  type RegistrationValues,
} from '../data/registration';
import { person } from '../data/person';
import CopyCommand from './CopyCommand.astro';

interface Props {
  values?: Partial<RegistrationValues>;
  errors?: RegistrationErrors;
}

const { values = {}, errors = {} } = Astro.props;
const value = { ...emptyValues, ...values };

/** Hints are permanent; error messages appear only after a failed submission.
 *  Both are announced through aria-describedby. */
const describedBy = (field: keyof RegistrationErrors, hasHint = false): string | undefined => {
  const ids = [hasHint ? `${field}-hint` : null, errors[field] ? `${field}-error` : null];
  const joined = ids.filter(Boolean).join(' ');
  return joined === '' ? undefined : joined;
};

const invalid = (field: keyof RegistrationErrors): 'true' | undefined =>
  errors[field] ? 'true' : undefined;

/** The tools ticked so far. One column holds them all, joined; the boxes are
 *  re-ticked from the same string when the endpoint re-renders the form. */
const tools = splitTools(value.tool);

/** Cloudflare's documented always-pass test key is the fallback, so the form
 *  works locally without any configuration. The real key is a build-time
 *  environment variable, PUBLIC_TURNSTILE_SITE_KEY. */
const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '1x00000000000000000000AA';

const hasErrors = Object.keys(errors).length > 0;

/** `data-form-root` is the handle the page's script uses: it submits this form
 *  with fetch and lifts the answer out of the endpoint's rendered response. The
 *  line below is the only message that does not come from the server, because
 *  when the request fails to arrive there is no answer to quote.
 *  draft: Mladen to approve. */
const failure = `Sending failed. Please try again or write to ${person.email}.`;
---

<form
  class="flow"
  method="post"
  action="/api/register/"
  data-form-root="register"
  data-fail={failure}
>
  {
    hasErrors && (
      <p class="notice notice--error" role="alert">
        {errors.form ?? 'Something below needs a second look. The details are next to the fields.'}
      </p>
    )
  }

  {
    /* Email is the only field that is required (MM-73): everything else helps
       Mladen prepare the room and may be left alone. Nothing but email carries
       the `required` attribute or the word beside its label. */
  }
  <div class="field">
    <label for="name">Name</label>
    <input
      id="name"
      name="name"
      type="text"
      autocomplete="name"
      maxlength="100"
      value={value.name === '' ? undefined : value.name}
      aria-describedby={describedBy('name')}
      aria-invalid={invalid('name')}
    />
    {errors.name && <p class="field__error" id="name-error">{errors.name}</p>}
  </div>

  {
    /* City carries no `data-laptop-only`: where someone comes from is worth
       knowing whether they bring a laptop or only a chair, so it stays visible
       for watchers too. */
  }
  <div class="field">
    <label for="city">City</label>
    <input
      id="city"
      name="city"
      type="text"
      placeholder="Novi Sad"
      autocomplete="address-level2"
      maxlength="100"
      value={value.city === '' ? undefined : value.city}
      aria-describedby={describedBy('city')}
      aria-invalid={invalid('city')}
    />
    {errors.city && <p class="field__error" id="city-error">{errors.city}</p>}
  </div>

  <div class="field">
    <label for="email">Email <span class="field__required">required</span></label>
    <input
      id="email"
      name="email"
      type="email"
      required
      autocomplete="email"
      maxlength="254"
      value={value.email === '' ? undefined : value.email}
      aria-describedby={describedBy('email', true)}
      aria-invalid={invalid('email')}
    />
    <p class="field__hint" id="email-hint">
      The confirmation and the preparation link go to this address.
    </p>
    {errors.email && <p class="field__error" id="email-error">{errors.email}</p>}
  </div>

  {
    /* The watch-only switch sits directly under the address, because it decides
       whether the rest of the form is asked at all (MM-72). Every block below
       that only matters to someone bringing a laptop carries
       `data-laptop-only`; the page's script hides those blocks while this box
       is ticked, and the endpoint ignores their values for a watch-only
       registration. With JavaScript off nothing is hidden and the endpoint's
       rule is what still holds. */
  }
  <div class="field">
    <div class="checkbox">
      <input
        id="watch_only"
        name="watch_only"
        type="checkbox"
        value="yes"
        checked={value.watch_only}
      />
      <label for="watch_only">I will watch, not work on my own laptop</label>
    </div>
  </div>

  <div class="field" data-laptop-only>
    <label for="github">GitHub username</label>
    <input
      id="github"
      name="github"
      type="text"
      autocomplete="off"
      spellcheck="false"
      pattern={githubPattern}
      maxlength="39"
      value={value.github === '' ? undefined : value.github}
      aria-describedby={describedBy('github', true)}
      aria-invalid={invalid('github')}
    />
    <p class="field__hint" id="github-hint">
      Just the username, as in github.com/<strong>username</strong>. Letters, numbers and
      hyphens.
    </p>
    {errors.github && <p class="field__error" id="github-error">{errors.github}</p>}
  </div>

  <div class="fieldset-row flow" data-laptop-only>
    <fieldset class="flow" aria-describedby={describedBy('os')}>
      <legend>Operating system</legend>
      <div class="choices">
        {
          osOptions.map((option) => (
            <div class="checkbox">
              <input
                id={`os-${option.value}`}
                name="os"
                type="radio"
                value={option.value}
                checked={value.os === option.value}
              />
              <label for={`os-${option.value}`}>{option.label}</label>
            </div>
          ))
        }
      </div>
      {errors.os && <p class="field__error" id="os-error">{errors.os}</p>}
    </fieldset>

    <fieldset class="flow" aria-describedby={describedBy('tool', true)}>
      <legend>AI tool</legend>
      <div class="choices">
        {
          toolOptions.map((option) => (
            <div class="checkbox">
              <input
                id={`tool-${option.value}`}
                name="tool"
                type="checkbox"
                value={option.value}
                checked={tools.includes(option.value)}
              />
              <label for={`tool-${option.value}`}>{option.label}</label>
            </div>
          ))
        }
      </div>
      <!-- draft: Mladen to approve — the group takes several answers, and since
           MM-73 none of them is required, so the hint no longer asks for one. -->
      <p class="field__hint" id="tool-hint">
        Tick every one you will have with you. Have it installed and logged in before
        you arrive.
      </p>
      {errors.tool && <p class="field__error" id="tool-error">{errors.tool}</p>}
    </fieldset>
  </div>

  <fieldset class="flow" aria-describedby={describedBy('terminal')} data-laptop-only>
    <legend>Terminal experience</legend>
    <div class="choices">
      {
        terminalOptions.map((option) => (
          <div class="checkbox">
            <input
              id={`terminal-${option.value}`}
              name="terminal"
              type="radio"
              value={option.value}
              checked={value.terminal === option.value}
            />
            <label for={`terminal-${option.value}`}>
              {option.label.includes(': ') ? (
                <>
                  <strong>{option.label.split(': ')[0]}</strong>: {option.label.split(': ').slice(1).join(': ')}
                </>
              ) : (
                option.label
              )}
            </label>
          </div>
        ))
      }
    </div>
    {errors.terminal && (
      <p class="field__error" id="terminal-error">{errors.terminal}</p>
    )}
  </fieldset>

  <div class="field" data-laptop-only>
    <label for="ssh_key">SSH public key</label>
    <textarea
      id="ssh_key"
      name="ssh_key"
      rows="3"
      spellcheck="false"
      autocomplete="off"
      aria-describedby={describedBy('ssh_key', true)}
      aria-invalid={invalid('ssh_key')}>{value.ssh_key}</textarea
    >
    <p class="field__hint" id="ssh_key-hint">
      Optional, for the deploy part. Print yours with{' '}
      <CopyCommand command="cat ~/.ssh/id_rsa.pub" /> or{' '}
      <CopyCommand command="cat ~/.ssh/id_ed25519.pub" />; it starts with{' '}
      <code>ssh-ed25519</code> or <code>ssh-rsa</code>.
    </p>
    {errors.ssh_key && <p class="field__error" id="ssh_key-error">{errors.ssh_key}</p>}
  </div>

  <fieldset class="flow">
    <legend>Anything else</legend>
    <div class="checkbox" data-laptop-only>
      <input
        id="own_hosting"
        name="own_hosting"
        type="checkbox"
        value="yes"
        checked={value.own_hosting}
      />
      <label for="own_hosting">I have my own hosting with SSH access</label>
    </div>
    <div class="checkbox">
      <input
        id="newsletter"
        name="newsletter"
        type="checkbox"
        value="yes"
        checked={value.newsletter}
      />
      <label for="newsletter">
        Send me news about Koder workshops, meetups and the Razgovori podcast
      </label>
    </div>
  </fieldset>

  <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light"></div>
  <noscript>
    <p class="field__hint">
      The anti-spam check needs JavaScript. With JavaScript off, write to{' '}<a
        href={`mailto:${person.email}`}>{person.email}</a
      >{' '}instead and you will be added by hand.
    </p>
  </noscript>

  <div class="row">
    <button class="button" type="submit">Register for the workshop</button>
  </div>
</form>

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer></script>
